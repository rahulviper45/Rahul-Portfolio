{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio/creative-ads",
      "destination": "/portfolio/creative-ads.html"
    },
    {
      "source": "/portfolio/illustration",
      "destination": "/portfolio/illustration.html"
    },
    {
      "source": "/portfolio/print-media",
      "destination": "/portfolio/print-media.html"
    },
    {
      "source": "/portfolio/video-ads",
      "destination": "/portfolio/video-ads.html"
    },
    {
      "source": "/portfolio/website-creatives",
      "destination": "/portfolio/website-creatives.html"
    }
  ]
}
